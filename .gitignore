# Game data: never commit anything from the disc.
/source/
/game/
# Other editions' and games' discs beside game/ (game-eur/, game-remix/,
# game-remix-eur/, ...): never committed.
/game-*/
*.iso
*.xbe
*.xiso
*_analysis.json

# Generated by tools/regen.sh (lifted C, ~100 MB) and the builds: one work
# folder per game (work-dub/, work-remix/); work/ before the split.
/work/
/work-*/
/gen/
/build*/
/switch_sd/
# The Android build (android/, ADR 0010): Gradle's caches and outputs, the
# NDK build's, and local.properties (this machine's SDK path).
/android/.gradle/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties

# Toolkit pipeline outputs, written inside the vendored tree.
/xboxrecomp/tools/*/output/

# Host clutter.
.DS_Store
__pycache__/
*.pyc
.vscode/
.idea/

# Personal folders
keys
bugs
drafts
assets/*
!assets/game-logo.jpeg
!preview.png
!switch.png
TODO.md
# Your own Switch settings (the template is switch/mcdub3_env.example.txt).
/switch/mcdub3_env.txt
/switch/mcdub3remix_env.txt
# Personal HD texture packs (beside game/; see hd_pack.c): never committed.
/hd/
