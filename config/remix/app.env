# The Remix's app identity, for every package of it (Switch NRO and NSP,
# Mac app, Windows exe): the same keys and rules as config/dub/app.env,
# see there. What both games share is switch/app.env.

APP_NAME="Midnight Club 3: DUB Edition Remix"
APP_VERSION="0.4.0"

# Editions: one NRO each (mcdub3remix-nx-<edition>.nro), from
# sdmc:/switch/mcdub3remix-nx/ (config/remix/xbe_editions.h). Both run on
# the European lift; the USA disc's one different branch is chosen at run
# time (config/remix/edition_variants.json).
APP_EDITIONS="eur usa"

# Forwarder title IDs: random, kept (see config/dub/app.env).
APP_TITLE_ID_eur="01cc7355d6e52000"     # 2026-10-24, PAL (Europe)
APP_NAME_eur="Midnight Club 3: DUB Edition Remix (Europe)"
APP_TITLE_ID_usa="011eaf71c0ca6000"     # 2026-10-25, NTSC-U

# The artwork (square, 1024x1024; personal, not in git).
APP_ICON="assets/cover-art-remix.jpg"
APP_LOGO_DIR="assets/logo"

APP_NRO_DIR="sdmc:/switch/mcdub3remix-nx"
