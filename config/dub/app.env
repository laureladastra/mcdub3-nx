# The DUB Edition's app identity, for every package of it: the Switch NRO
# (hbmenu) and NSP forwarder (home menu), the Mac app, the Windows exe.
# Plain KEY=VALUE, read through mc3_app_env (tools/env.sh) by
# switch/build.sh, switch/nsp.sh, tools/mac_app.sh, tools/build_windows.sh
# and CI. What both games share (author, pinned tools) is switch/app.env.
# Change the version here for a release.

APP_NAME="Midnight Club 3: DUB Edition"
APP_VERSION="0.5.0"

# Editions of the game: one NRO each (mcdub3-nx-<edition>.nro, make switch
# EDITION=<edition>) and one NSP forwarder each, starting that NRO from
# sdmc:/switch/mcdub3-nx/. They share one lift (config/dub/xbe_editions.h:
# the discs' code is the same); each NRO looks for its disc in
# game-<edition>/ on the card first, then game/. Space-separated.
APP_EDITIONS="usa eur"

# Per edition, a suffix on the variable (a '-' of the edition becomes '_':
# pal-es -> APP_TITLE_ID_pal_es):
#   APP_TITLE_ID_<edition>  the forwarder's title ID (required for an NSP):
#       drawn at random in the range hacBrewPack recommends
#       (0x0100000000000000-0x01ffffffffffffff), lower case, ending in 000
#       like an application's. Keep them: a new ID installs a second app. A
#       new edition gets a fresh random one (not a neighbour: IDs after an
#       application's are its add-ons).
#   APP_NAME_<edition>      its name in hbmenu and the home menu (default APP_NAME)
#   APP_ICON_<edition>      its artwork (default APP_ICON)
APP_TITLE_ID_usa="010c46f75536e000"     # 2026-10-16, NTSC-U
APP_TITLE_ID_eur="013594aaa6996000"     # 2026-10-24, PAL (Europe)
APP_NAME_eur="Midnight Club 3: DUB Edition (Europe)"

# The artwork, square, any size (1024x1024 is best), JPEG or PNG; personal,
# not in git (assets/ is ignored). Each package derives its icon from it:
# the Switch a bare 256x256 baseline JPEG (tools/app_icon.py), the Mac a
# rounded .icns (tools/mac_icon.py), Windows an .ico (tools/windows/
# win_icon.py). No artwork: a default icon.
APP_ICON="assets/cover-art.jpg"

# Start-up logo for the NSP (switch/nsp.sh): NintendoLogo.png (256x128) and
# StartupMovie.gif (256x80) in this folder (personal) replace NTON's.
APP_LOGO_DIR="assets/logo"

# Where the forwarders find the NROs on the SD card (make switch stages
# them there): <APP_NRO_DIR>/mcdub3-nx-<edition>.nro.
APP_NRO_DIR="sdmc:/switch/mcdub3-nx"
